{
  "name": "at-ui",
  "version": "2.0.0",
  "type": "module",
  "description": "A UI Component Library with React",
  "main": "./dist/at.umd.cjs",
  "module": "./dist/at.es.js",
  "style": "./dist/at.css",
  "exports": {
    ".": {
      "import": "./dist/at.es.js",
      "require": "./dist/at.umd.cjs"
    },
    "./style.css": "./dist/at.css",
    "./dist/at.css": "./dist/at.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build:component",
    "build:component": "vite build --config vite.config.js",
    "prepublishOnly": "npm run lint && npm test && npm run build:component"
  },
  "keywords": [
    "at",
    "at-ui",
    "desktop",
    "ui",
    "framework",
    "component",
    "react"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "async-validator": "^4.2.5",
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.0.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sass": "^1.97.2",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
